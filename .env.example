# ──────────────────────────────────────────────────────────────
# SMTP configuration for the contact form (Nodemailer)
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real credentials.
# ──────────────────────────────────────────────────────────────

# Your mail server host, e.g. smtp.zoho.in / smtp.gmail.com / mail.yourdomain.com
SMTP_HOST=smtp.example.com

# 465 for SSL, 587 for STARTTLS
SMTP_PORT=465

# true for port 465, false for port 587
SMTP_SECURE=true

# SMTP login (usually the full email address)
SMTP_USER=contact@shrimalassociates.in

# SMTP password or app-specific password
SMTP_PASS=your-smtp-password-or-app-password

# Address the enquiry e-mail is sent FROM (often same as SMTP_USER)
SMTP_FROM="Shrimal & Associates Website <contact@shrimalassociates.in>"

# Address that receives the contact-form enquiries
CONTACT_TO=contact@shrimalassociates.in
